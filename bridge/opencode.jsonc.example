{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "blender": {
      "type": "local",
      "command": ["python3", "/ABSOLUTE/PATH/TO/blender-bridge/mcp_server.py"],
      "environment": {
        "BLENDER_BRIDGE_PORT": "7788"
      },
      "timeout": 300000,
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 300000
  }
}
